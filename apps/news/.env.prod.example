# Copy to .env next to compose.prod.yaml on the homelab. Never commit the filled-in file.
GHCR_OWNER=karanravindra
NEWS_TAG=latest
WEB_PORT=3000

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Ollama on the Docker host. Swap the model tags if the host is not Apple Silicon (the *-mlx tag is Mac-only).
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_MODEL=embeddinggemma-2:270m
EMBED_DIM=768
TOPIC_BASE_URL=http://host.docker.internal:11434
TOPIC_MODEL=gemma4:e2b-mlx
# SUMMARIES=on
# SUMMARY_BASE_URL=http://host.docker.internal:11434
# SUMMARY_MODEL=gemma4:e2b-mlx
