DATABASE_URL=postgres://news:news@localhost:5433/news

# Embeddings via Ollama OpenAI-compatible API
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=embeddinggemma-2:270m

REDIS_URL=redis://localhost:6380

EMBED_DIM=768
EMBED_PREFIX=

# Clustering thresholds (cosine on mean-centred vectors). Defaults are tuned for embeddinggemma-2:270m with no prefix.
# Re-tune after changing the model: `bun src/main.ts cluster --rebuild --join 0.66 --seed 0.70 --merge 0.75`, then `stories --sims`.
# CLUSTER_JOIN_SIM=0.66
# CLUSTER_SEED_SIM=0.70
# CLUSTER_MERGE_SIM=0.75
# CLUSTER_MIN_OUTLETS=3
# CLUSTER_MAX_GAP_HOURS=36
