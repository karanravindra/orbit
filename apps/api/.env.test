# Loaded automatically by `bun test`. Points at the Postgres service in compose.yml.
NODE_ENV=test
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit
BETTER_AUTH_SECRET=test-secret-not-for-production-0123456789
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
ADMIN_EMAILS=admin@example.com
# Cloudflare's documented always-pass test secret; siteverify is stubbed in tests/setup.ts.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
EMAIL_PROVIDER=memory
