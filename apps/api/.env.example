# development or test; unset means production, which enforces real secrets.
NODE_ENV=development
PORT=3000
DATABASE_PATH=../../orbit.sqlite
SHUTDOWN_TIMEOUT_MS=10000
MAX_BODY_BYTES=1048576
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app, used for links in emails.
APP_URL=http://localhost:5173
# Comma-separated emails that become platform admins once verified.
ADMIN_EMAILS=
# Cloudflare Turnstile secret. For local dev use Cloudflare's always-pass test
# secret, 1x0000000000000000000000000000000AA (rejected in production).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# console for development, memory for tests, resend for production.
EMAIL_PROVIDER=console
EMAIL_FROM=Orbit <noreply@localhost>
# Required with EMAIL_PROVIDER=resend. Use a verified sender domain above.
# RESEND_API_KEY=re_...
