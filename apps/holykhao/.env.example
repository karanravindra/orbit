# Any OpenAI-compatible chat endpoint. Default is a local Ollama.
HOLYKHAO_LLM_URL=http://localhost:11434/v1
# Must be vision-capable for `import` (it reads the notebook photos).
HOLYKHAO_MODEL=lfm2.5-vl:3b
# Only for servers that need a key; Ollama ignores it.
HOLYKHAO_LLM_API_KEY=
# How many times to ask again when the model returns unusable JSON.
HOLYKHAO_LLM_ATTEMPTS=3
HOLYKHAO_DB=data/holykhao.db
