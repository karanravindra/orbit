{
	"name": "orbit",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"lefthook": "^2.2.1",
		"typescript": "^7"
	},
	"scripts": {
		"check": "biome check .",
		"typecheck": "bun run --filter '*' typecheck",
		"db:generate": "bun run --filter @orbit/db generate",
		"db:migrate": "bun run --filter @orbit/db migrate",
		"prepare": "lefthook install"
	}
}
